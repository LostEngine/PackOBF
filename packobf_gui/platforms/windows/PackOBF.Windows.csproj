<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>PackOBF</AssemblyName>
    <RootNamespace>PackObf.Windows</RootNamespace>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>$(TargetPlatformMinVersion)</SupportedOSPlatformVersion>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == 'AnyCPU'">x64</Platform>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GuiDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..'))</GuiDirectory>
    <CargoTargetDir>$(GuiDirectory)\target</CargoTargetDir>
    <RustTarget Condition="'$(Platform)' == 'x64'">x86_64-pc-windows-msvc</RustTarget>
    <RustTarget Condition="'$(Platform)' == 'ARM64'">aarch64-pc-windows-msvc</RustTarget>
    <CargoProfile Condition="'$(Configuration)' == 'Release'">release</CargoProfile>
    <CargoProfile Condition="'$(CargoProfile)' == ''">dev</CargoProfile>
    <CargoOutputProfile Condition="'$(CargoProfile)' == 'dev'">debug</CargoOutputProfile>
    <CargoOutputProfile Condition="'$(CargoOutputProfile)' == ''">$(CargoProfile)</CargoOutputProfile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <Content Include="$(CargoTargetDir)\$(RustTarget)\$(CargoOutputProfile)\packobf_gui.dll"
             Link="packobf_gui.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BuildRustBackend" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(RustTarget)' == ''" Text="Build PackOBF for x64 or ARM64." />
    <Exec WorkingDirectory="$(GuiDirectory)"
          Command="cargo rustc --locked --lib --features ffi --profile $(CargoProfile) --target $(RustTarget) --target-dir &quot;$(CargoTargetDir)&quot; --crate-type cdylib" />
  </Target>

  <!-- The unpackaged Windows App SDK build omits application XAML assets from publish. -->
  <Target Name="PublishXamlResources" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <AppXamlResource Include="$(TargetDir)$(AssemblyName).pri;$(TargetDir)*.xbf"
                       Exclude="@(ResolvedFileToPublish)" />
      <ResolvedFileToPublish Include="@(AppXamlResource)">
        <RelativePath>%(AppXamlResource.Filename)%(AppXamlResource.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
